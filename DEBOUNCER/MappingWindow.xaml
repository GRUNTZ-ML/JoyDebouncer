<Window x:Class="JoystickMapperUI.MappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller Mapping Setup" Height="530" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Button Index Remapping (DirectInput)" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Button A Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtA" Grid.Row="0" Grid.Column="1" Text="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Button B Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtB" Grid.Row="1" Grid.Column="1" Text="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="Button X Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtX" Grid.Row="2" Grid.Column="1" Text="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="3" Text="Button Y Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtY" Grid.Row="3" Grid.Column="1" Text="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4" Text="Left Shoulder (LB):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLB" Grid.Row="4" Grid.Column="1" Text="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Text="Right Shoulder (RB):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtRB" Grid.Row="5" Grid.Column="1" Text="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="6" Text="Left Trigger (LT):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtLT" Grid.Row="6" Grid.Column="1" Text="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="7" Text="Right Trigger (RT):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtRT" Grid.Row="7" Grid.Column="1" Text="7" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="8" Text="Back / Select Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtBack" Grid.Row="8" Grid.Column="1" Text="8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="9" Text="Start Index:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStart" Grid.Row="9" Grid.Column="1" Text="9" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="10" Text="Left Thumb (L3):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtL3" Grid.Row="10" Grid.Column="1" Text="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="11" Text="Right Thumb (R3):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtR3" Grid.Row="11" Grid.Column="1" Text="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <Button x:Name="BtnSave" Content="Save &amp; Close" Height="36" Background="#2980B9" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>